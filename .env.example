# Database connection string (used when persistent storage is configured)
# Example: postgresql://user:password@localhost:5432/skill-shield
DATABASE_URL=

# Public-facing URL of the application (used for links and redirects)
# Production: https://ai-skill-shield.suppeng.com
# Local development may use http://localhost:3000
NEXT_PUBLIC_APP_URL=https://ai-skill-shield.suppeng.com

# GitHub personal access token (used for GitHub integration features)
# Minimum scopes: public_repo for public repos, repo for private
GITHUB_TOKEN=

# Optional GitHub App for automatic, owner-approved scan notifications.
# Install the App only on repositories whose owners want a single issue updated
# after every new default-branch scan. The private key may use literal \n escapes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional AI review providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenCode Go API key and optional model override
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=kimi-k2.7-code

# OpenCode Zen API key and optional model override
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=kimi-k2.7-code

# Number of days to retain completed scan results before auto-cleanup
SCAN_RETENTION_DAYS=30

# Optional Redis scan cache. Cached entries point to durable reports in the database.
REDIS_URL=redis://localhost:6379
SCAN_CACHE_TTL_SECONDS=2592000
EXPLORE_CACHE_TTL_SECONDS=300

# Node environment: development, test, or production
NODE_ENV=development
